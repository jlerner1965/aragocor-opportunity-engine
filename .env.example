# Set these in Vercel → this project → Settings → Environment Variables
# (tick Production and Preview), then redeploy. Never commit real values.

# REQUIRED. The team password. Sign in with any username (it's shown on RFPs
# you log) and this password. Until it's set the whole site stays locked.
DASHBOARD_PASSWORD=

# REQUIRED for the SAM.gov feed. SAM.gov → your profile → Account Details →
# Public API Key. CanadaBuys, EU TED and the World Bank need no key.
SAM_API_KEY=

# OPTIONAL. Comma-separated keywords. When set, the server always uses these
# and the keyword box in Settings is locked.
RFP_KEYWORDS=

# SHARED WORKSPACE (recommended). Don't type these: in Vercel open Storage →
# Create Database → Upstash for Redis (free plan) → connect it to this project,
# and Vercel adds them. Without them each browser keeps its own data.
KV_REST_API_URL=
KV_REST_API_TOKEN=
